---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { appNameShort } from '../data/brand';
import { termsSections } from '../data/site';
import { webPageJsonLd } from '../data/seo';

const pageTitle = 'Terms of use';
const pageDescription = `Terms for ${appNameShort}, the free app for passport, visa, and ID photos. Document specs, acceptable use, and on-device data handling.`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  jsonLd={webPageJsonLd(pageTitle, pageDescription, Astro.url.pathname, Astro.site)}
>
  <Header slot="header" />
  <Footer slot="footer" />

  <div class="page-legal">
    <div class="container">
      <article class="prose">
        <h1>Terms of use</h1>
        <p class="lead">
          These terms apply to {appNameShort}. Please read them together with our{' '}
          <a href="/privacy">privacy policy</a>.
        </p>

        {
          termsSections.map((section) => (
            <>
              <h2>{section.title}</h2>
              <p>{section.body}</p>
            </>
          ))
        }

        <h2>Questions</h2>
        <p>
          For help using {appNameShort}, see our <a href="/support">support page</a> for FAQs and resources.
        </p>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .page-legal {
    padding: clamp(2rem, 6vw, 3.5rem) 0 clamp(4rem, 10vw, 6rem);
  }
</style>
