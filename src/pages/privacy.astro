---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { privacySections } from '../data/site';
---

<BaseLayout
  title="Privacy policy"
  description="How IDLens handles your photos and data—everything processed on your phone."
>
  <Header slot="header" />
  <Footer slot="footer" />

  <div class="page-legal">
    <div class="container">
      <article class="prose">
        <h1>Privacy policy</h1>
        <p class="lead">
          IDLens makes ID and visa photos on your phone. This policy explains what the app does with your data.
        </p>

        {
          privacySections.map((section) => (
            <>
              <h2>{section.title}</h2>
              <p>{section.body}</p>
            </>
          ))
        }

        <h2>Contact</h2>
        <p>
          Questions about privacy? Visit our <a href="/support">support page</a> or email us through the
          contact options listed there.
        </p>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .page-legal {
    padding: clamp(2rem, 6vw, 3.5rem) 0 clamp(4rem, 10vw, 6rem);
  }
</style>
