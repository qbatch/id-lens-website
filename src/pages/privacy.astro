---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { appNameShort } from '../data/brand';
import { privacySections } from '../data/site';
import { webPageJsonLd } from '../data/seo';

const pageTitle = 'Privacy policy';
const pageDescription = `Learn how ${appNameShort} handles photos and personal data. On-device processing, encrypted storage, optional analytics, and no photo uploads.`;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  jsonLd={webPageJsonLd(pageTitle, pageDescription, Astro.url.pathname, Astro.site)}
>
  <Header slot="header" />
  <Footer slot="footer" />

  <div class="page-legal">
    <div class="container">
      <article class="prose">
        <h1>Privacy policy</h1>
        <p class="lead">
          {appNameShort} makes ID and visa photos on your phone. This policy explains what the app does with your data.
          Use of the app is also governed by our <a href="/terms">terms of use</a>.
        </p>

        {
          privacySections.map((section) => (
            <>
              <h2>{section.title}</h2>
              <p>{section.body}</p>
            </>
          ))
        }

        <h2>Contact</h2>
        <p>
          Questions about privacy? See our <a href="/support">support page</a> for FAQs and resources.
        </p>
      </article>
    </div>
  </div>
</BaseLayout>

<style>
  .page-legal {
    padding: clamp(2rem, 6vw, 3.5rem) 0 clamp(4rem, 10vw, 6rem);
  }
</style>
