---
import '../styles/global.css';
import { appName, appNameShort, appStoreId } from '../data/brand';
import { defaultDescription, ogImagePath } from '../data/seo';

interface Props {
  title: string;
  description?: string;
  /** When true, use `title` as the document title without appending the brand. */
  titleIsFull?: boolean;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = defaultDescription,
  titleIsFull = false,
  ogImage = ogImagePath,
  noindex = false,
  jsonLd,
} = Astro.props;

const site = Astro.site ?? new URL('https://passportphotofit.lixul.com');
const canonicalURL = new URL(Astro.url.pathname, site);
const ogImageURL = new URL(ogImage, site);
const fullTitle = titleIsFull ? title : title === appName ? title : `${title} · ${appNameShort}`;
const robots = noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#2F5BEA" />
    <meta name="application-name" content={appNameShort} />
    <meta name="apple-mobile-web-app-title" content={appNameShort} />
    <meta name="apple-itunes-app" content={`app-id=${appStoreId}`} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:site_name" content={appNameShort} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={ogImageURL.href} />
    <meta property="og:image:alt" content={`${appName} — passport and visa photos on your phone`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL.href} />
    <title>{fullTitle}</title>
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
    <slot name="head" />
  </head>
  <body>
    <div class="page-shell">
      <slot name="header" />
      <main class="page-main" id="main-content">
        <slot />
      </main>
      <slot name="footer" />
    </div>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 600;
    border-radius: var(--radius-md);
  }

  .skip-link:focus {
    left: 1rem;
    top: 1rem;
  }
</style>
