---
import '../styles/global.css';
import { appName, appNameShort } from '../data/brand';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = `Make passport and visa ID photos on your phone with ${appNameShort}. Free, private, on-device—no upload, no account.`,
} = Astro.props;

const fullTitle = title === appName ? title : `${title} · ${appNameShort}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#2F5BEA" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <title>{fullTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <div class="page-shell">
      <slot name="header" />
      <main class="page-main" id="main-content">
        <slot />
      </main>
      <slot name="footer" />
    </div>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -9999px;
    top: 0;
    z-index: 100;
    padding: 0.75rem 1rem;
    background: var(--color-accent);
    color: var(--color-on-accent);
    font-weight: 600;
    border-radius: var(--radius-md);
  }

  .skip-link:focus {
    left: 1rem;
    top: 1rem;
  }
</style>
